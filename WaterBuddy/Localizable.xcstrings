    "Skips a reminder when you've already drunk your share for its hour.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skips a reminder when you've already drunk your share for its hour."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропускает напоминание, если к его часу вы уже выпили свою долю."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Shu soatgacha ulushingizni ichib bo‘lgan bo‘lsangiz, eslatma o‘tkazib yuboriladi."
          }
        }
      }
    },
    "Opens Premium": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Premium"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает Premium"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium’ni ochadi"
          }
        }
      }
    },
    "Reminds you to drink at the hours of your schedule": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminds you to drink at the hours of your schedule"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминает пить в часы вашего расписания"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadvalingizdagi soatlarda suv ichishni eslatadi"
          }
        }
      }
    },
    "A nudge at each hour of your schedule, skipped if you drank in the hour before it. Reaching your goal silences the rest of the day.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A nudge at each hour of your schedule, skipped if you drank in the hour before it. Reaching your goal silences the rest of the day."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминание в каждый час вашего расписания. Оно пропускается, если за час до него вы пили воду. Достижение цели отключает остальные напоминания до конца дня."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadvalingizdagi har soatda eslatma. Undan oldingi bir soat ichida suv ichgan bo‘lsangiz, u o‘tkazib yuboriladi. Maqsadga erishilsa, kun oxirigacha eslatmalar to‘xtaydi."
          }
        }
      }
    },
    "A nudge at each hour of your schedule, unless you drank in the hour before it or have already reached your goal. Your notification summary is on, so reminders may arrive in a batch rather than on the hour.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A nudge at each hour of your schedule, unless you drank in the hour before it or have already reached your goal. Your notification summary is on, so reminders may arrive in a batch rather than on the hour."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминание в каждый час вашего расписания, если за час до него вы не пили воду и ещё не достигли цели. У вас включена сводка уведомлений, поэтому напоминания могут приходить пачкой, а не точно в назначенный час."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadvalingizdagi har soatda eslatma, agar undan oldingi bir soatda suv ichmagan va maqsadga erishmagan bo‘lsangiz. Bildirishnomalar xulosasi yoqilgan, shuning uchun eslatmalar aynan soatida emas, jamlanib kelishi mumkin."
          }
        }
      }
    },
