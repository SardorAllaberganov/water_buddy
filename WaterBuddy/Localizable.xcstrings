    "Notifications are turned off for WaterBuddy in iOS Settings, so reminders can't be delivered.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are turned off for WaterBuddy in iOS Settings, so reminders can't be delivered."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления для WaterBuddy отключены в настройках iOS, поэтому напоминания не будут приходить."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "WaterBuddy uchun bildirishnomalar iOS sozlamalarida o‘chirilgan, shuning uchun eslatmalar yetkazilmaydi."
          }
        }
      }
    },
