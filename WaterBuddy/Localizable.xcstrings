    "Extras for the way you drink. Logging water stays free.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extras for the way you drink. Logging water stays free."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дополнения под ваш ритм. Записывать воду — по-прежнему бесплатно."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Odatingizga mos qo‘shimchalar. Suv yozib borish bepulligicha qoladi."
          }
        }
      }
    },
    "Free trial: %1$@. Then %2$@ is charged each year until you cancel. Cancel at least 24 hours before it renews, in your Apple Account settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free trial: %1$@. Then %2$@ is charged each year until you cancel. Cancel at least 24 hours before it renews, in your Apple Account settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробный период: %1$@. Затем %2$@ списывается каждый год, пока вы не отмените подписку. Отмените её не позднее чем за 24 часа до продления в настройках аккаунта Apple."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepul sinov: %1$@. So‘ng obunani bekor qilmaguningizcha har yili %2$@ yechiladi. Uni yangilanishdan kamida 24 soat oldin Apple hisobingiz sozlamalarida bekor qiling."
          }
        }
      }
    },
