    "A glass now keeps you on track for the day.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A glass now keeps you on track for the day."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стакан сейчас — и день пройдёт по плану."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozir bir stakan — kun rejada davom etadi."
          }
        }
      }
    },
    "A nudge every two hours from 9 AM to 9 PM, unless you've already reached your goal. Your notification summary is on, so reminders may arrive in a batch rather than on the hour.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A nudge every two hours from 9 AM to 9 PM, unless you've already reached your goal. Your notification summary is on, so reminders may arrive in a batch rather than on the hour."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминание каждые два часа с 9:00 до 21:00, если цель ещё не достигнута. У вас включена сводка уведомлений, поэтому напоминания могут приходить пачкой, а не точно по часам."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "9:00 dan 21:00 gacha har ikki soatda eslatma, agar maqsadga hali erishmagan bo‘lsangiz. Bildirishnomalar jamlanmasi yoqilgan, shuning uchun eslatmalar soat sayin emas, to‘plam bo‘lib kelishi mumkin."
          }
        }
      }
    },
    "A nudge every two hours from 9 AM to 9 PM. Logging water pushes the next one back, and reaching your goal silences the rest of the day.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A nudge every two hours from 9 AM to 9 PM. Logging water pushes the next one back, and reaching your goal silences the rest of the day."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминание каждые два часа с 9:00 до 21:00. Запись воды отодвигает следующее, а достижение цели отключает остальные до конца дня."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "9:00 dan 21:00 gacha har ikki soatda eslatma. Suv qayd etilsa keyingisi keyinroqqa suriladi, maqsadga erishilsa kun oxirigacha eslatmalar to‘xtaydi."
          }
        }
      }
    },
