          }
        }
      }
    },
    "%1$@ free, then %2$@ a year": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ free, then %2$@ a year"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ бесплатно, затем %2$@ в год"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bepul, keyin yiliga %2$@"
          }
        }
      }
    },
    "%1$@ is charged each year until you cancel. Cancel at least 24 hours before it renews, in your Apple Account settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is charged each year until you cancel. Cancel at least 24 hours before it renews, in your Apple Account settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ списывается каждый год, пока вы не отмените подписку. Отмените её не позднее чем за 24 часа до продления в настройках аккаунта Apple."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Obunani bekor qilmaguningizcha har yili %1$@ yechiladi. Uni yangilanishdan kamida 24 soat oldin Apple hisobingiz sozlamalarida bekor qiling."
          }
        }
      }
    },
    "%1$@, once": {
      "extractionState": "manual",
