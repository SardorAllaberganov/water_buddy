    "%1$@ is charged each month until you cancel. Cancel at least 24 hours before it renews, in your Apple Account settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is charged each month until you cancel. Cancel at least 24 hours before it renews, in your Apple Account settings."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cobra %1$@ cada mes hasta que canceles. Cancela al menos 24 horas antes de que se renueve, en la configuración de tu cuenta de Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ списывается каждый месяц, пока вы не отмените подписку. Отмените её не позднее чем за 24 часа до продления в настройках аккаунта Apple."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Obunani bekor qilmaguningizcha har oy %1$@ yechiladi. Uni yangilanishdan kamida 24 soat oldin Apple hisobingiz sozlamalarida bekor qiling."
          }
        }
      }
