        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дата, время, объём в миллилитрах и напиток, больше ничего. Файл покинет телефон, только когда вы его отправите."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
